PORT=5000
MONGO_URI=mongodb://localhost:27017/vendor-billing-portal
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=

# From your Cloudinary dashboard (cloudinary.com) — Cloud Name/API Key/API
# Secret are all shown right on the dashboard homepage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# n8n Webhook-trigger node's Production URL — every Daily Progress Report
# submission POSTs a flat JSON payload here (including the project's
# slackChannelId), and the n8n workflow routes it to the right Slack channel.
# Leave blank to disable.
N8N_DPR_WEBHOOK= 

# Daily automatic backup email (GET /api/backup/scheduled, triggered by an
# external cron pinger like cron-job.org since Render's free plan sleeps).
# Render blocks outbound SMTP, so this goes through Resend's HTTP API —
# get a key at resend.com (free tier).
RESEND_API_KEY=

# Where the daily backup email should be sent.
BACKUP_EMAIL_TO=

# Shared secret the external cron trigger must send as the X-Cron-Secret
# header when calling GET /api/backup/scheduled. Generated locally; put the
# same value into the cron trigger's custom-header config.
BACKUP_CRON_SECRET=

